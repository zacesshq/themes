{
  "manifest_version": 3,
  "name": "Zacess High Contrast Light",
  "version": "0.12.1",
  "description": "Black on white with strong dark borders and focus outlines, for the highest contrast on a light screen.",
  "homepage_url": "https://github.com/zacesshq/themes",
  "browser_specific_settings": {
    "gecko": {
      "id": "theme-high-contrast-light@zacess.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "theme": {
    "colors": {
      "frame": "#262626",
      "frame_inactive": "#262626",
      "tab_background_text": "#ffffff",
      "tab_selected": "#ffffff",
      "tab_text": "#000000",
      "tab_line": "#003d99",
      "tab_loading": "#003d99",
      "toolbar": "#ffffff",
      "toolbar_text": "#000000",
      "icons": "#000000",
      "icons_attention": "#003d99",
      "toolbar_top_separator": "#262626",
      "toolbar_bottom_separator": "#262626",
      "toolbar_vertical_separator": "#262626",
      "toolbar_field": "#fff1a0",
      "toolbar_field_text": "#000000",
      "toolbar_field_border": "#262626",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#000000",
      "toolbar_field_border_focus": "#003d99",
      "toolbar_field_highlight": "#015f5e",
      "toolbar_field_highlight_text": "#ffffff",
      "popup": "#ffffff",
      "popup_text": "#000000",
      "popup_border": "#262626",
      "popup_highlight": "#015f5e",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#ffffff",
      "sidebar_text": "#000000",
      "sidebar_border": "#262626",
      "sidebar_highlight": "#015f5e",
      "sidebar_highlight_text": "#ffffff",
      "ntp_background": "#ffffff",
      "ntp_text": "#000000",
      "focus_outline": "#003d99"
    },
    "properties": {
      "color_scheme": "light"
    }
  }
}
