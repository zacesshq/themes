{
  "manifest_version": 3,
  "name": "Zacess Deep Contrast Light",
  "version": "0.12.1",
  "description": "Black on white with vivid deep colours, red focus outlines and navy frames, for low vision.",
  "homepage_url": "https://github.com/zacesshq/themes",
  "browser_specific_settings": {
    "gecko": {
      "id": "theme-deep-contrast-light@zacess.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "theme": {
    "colors": {
      "frame": "#0f4a85",
      "frame_inactive": "#0f4a85",
      "tab_background_text": "#ffffff",
      "tab_selected": "#ffffff",
      "tab_text": "#000000",
      "tab_line": "#0f4a85",
      "tab_loading": "#0f4a85",
      "toolbar": "#ffffff",
      "toolbar_text": "#000000",
      "icons": "#000000",
      "icons_attention": "#0f4a85",
      "toolbar_top_separator": "#0f4a85",
      "toolbar_bottom_separator": "#0f4a85",
      "toolbar_vertical_separator": "#0f4a85",
      "toolbar_field": "#f0f5ff",
      "toolbar_field_text": "#000000",
      "toolbar_field_border": "#0f4a85",
      "toolbar_field_focus": "#ffffff",
      "toolbar_field_text_focus": "#000000",
      "toolbar_field_border_focus": "#0f4a85",
      "toolbar_field_highlight": "#990098",
      "toolbar_field_highlight_text": "#ffffff",
      "popup": "#ffffff",
      "popup_text": "#000000",
      "popup_border": "#0f4a85",
      "popup_highlight": "#990098",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#ffffff",
      "sidebar_text": "#000000",
      "sidebar_border": "#0f4a85",
      "sidebar_highlight": "#990098",
      "sidebar_highlight_text": "#ffffff",
      "ntp_background": "#ffffff",
      "ntp_text": "#000000",
      "focus_outline": "#0f4a85"
    },
    "properties": {
      "color_scheme": "light"
    }
  }
}
