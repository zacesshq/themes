# EditorConfig, applied by most editors automatically.
# see https://editorconfig.org for documentation.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# the Kotlin and Gradle convention
[*.{kt,kts}]
indent_size = 4

# the Windows wrapper script is run by cmd.exe, which expects CRLF
[*.bat]
end_of_line = crlf

# the iTerm2 colour files are plists written with tabs
[*.itermcolors]
indent_style = tab

# two trailing spaces are a hard line break in markdown
[*.md]
trim_trailing_whitespace = false
