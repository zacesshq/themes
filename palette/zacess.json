{
  "$schema": "./schema.json",
  "name": "Zacess",
  "version": "0.2.1",
  "rules": {
    "textContrast": 7,
    "findMatchContrast": 4.5,
    "nonTextContrast": 3,
    "ansiFloor": 4.5,
    "toneStep": 0.05,
    "deficiencyDistance": 0.04
  },
  "tokens": {
    "keyword": {
      "style": [
        "bold"
      ],
      "description": "Declarations and other keywords such as const, class and fn"
    },
    "control": {
      "style": [
        "bold"
      ],
      "description": "Control flow such as if, return, for and import"
    },
    "function": {
      "style": [],
      "description": "Function and method names"
    },
    "type": {
      "style": [],
      "description": "Types, classes, interfaces and enums"
    },
    "variable": {
      "style": [],
      "description": "Variables and identifiers"
    },
    "parameter": {
      "style": [
        "italic"
      ],
      "description": "Function parameters"
    },
    "property": {
      "style": [],
      "description": "Object properties, fields and keys"
    },
    "string": {
      "style": [],
      "description": "Strings and characters"
    },
    "number": {
      "style": [],
      "description": "Numbers, booleans and other constants"
    },
    "comment": {
      "style": [
        "italic"
      ],
      "description": "Comments, never dimmed below the contrast floor"
    },
    "operator": {
      "style": [],
      "description": "Operators and punctuation"
    },
    "tag": {
      "style": [
        "bold"
      ],
      "description": "Markup tags"
    },
    "attribute": {
      "style": [],
      "description": "Markup attributes"
    },
    "regex": {
      "style": [],
      "description": "Regular expressions"
    },
    "invalid": {
      "style": [
        "underline"
      ],
      "description": "Invalid code and illegal characters"
    },
    "added": {
      "style": [],
      "description": "Added lines in a diff"
    },
    "removed": {
      "style": [],
      "description": "Removed lines in a diff"
    },
    "changed": {
      "style": [],
      "description": "Changed lines in a diff"
    }
  },
