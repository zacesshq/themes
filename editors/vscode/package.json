{
  "name": "zacess-themes",
  "displayName": "Zacess Themes",
  "description": "Ten accessible code themes: four matching the Zacess reader (Light, Dark, Yellow on Black for low vision and Cream for dyslexia), four maximum contrast themes (High Contrast Dark, High Contrast Light, Deep Contrast Dark and Deep Contrast Light) and the gentler Warm Dark and Warm Light. Every text and syntax colour keeps 7:1 contrast on the background (4.5:1 in the Warm pair) and selections stand out in a colour of their own.",
  "version": "1.0.0",
  "publisher": "zacess",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#111111",
    "theme": "dark"
  },
  "homepage": "https://github.com/zacesshq/themes",
  "repository": {
    "type": "git",
    "url": "https://github.com/zacesshq/themes.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/zacesshq/themes/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "high contrast",
    "accessibility",
    "low vision",
    "dyslexia",
    "WCAG",
    "AAA",
    "colour blind",
    "yellow on black",
    "cream",
    "warm"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Zacess Light",
        "uiTheme": "vs",
        "path": "./themes/zacess-light-color-theme.json"
      },
      {
        "label": "Zacess Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/zacess-dark-color-theme.json"
      },
      {
        "label": "Zacess Yellow on Black",
        "uiTheme": "hc-black",
        "path": "./themes/zacess-yellow-on-black-color-theme.json"
      },
      {
        "label": "Zacess Cream",
        "uiTheme": "vs",
        "path": "./themes/zacess-cream-color-theme.json"
      },
      {
        "label": "Zacess High Contrast Dark",
        "uiTheme": "hc-black",
        "path": "./themes/zacess-high-contrast-dark-color-theme.json"
      },
      {
        "label": "Zacess High Contrast Light",
        "uiTheme": "hc-light",
        "path": "./themes/zacess-high-contrast-light-color-theme.json"
      },
      {
        "label": "Zacess Deep Contrast Dark",
        "uiTheme": "hc-black",
        "path": "./themes/zacess-deep-contrast-dark-color-theme.json"
      },
      {
        "label": "Zacess Deep Contrast Light",
        "uiTheme": "hc-light",
        "path": "./themes/zacess-deep-contrast-light-color-theme.json"
      },
      {
        "label": "Zacess Warm Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/zacess-warm-dark-color-theme.json"
      },
      {
        "label": "Zacess Warm Light",
        "uiTheme": "vs",
        "path": "./themes/zacess-warm-light-color-theme.json"
      }
    ]
  }
}
