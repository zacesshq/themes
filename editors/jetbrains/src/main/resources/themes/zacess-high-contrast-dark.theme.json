      "startBorderColor": "#a6a6a6",
      "endBorderColor": "#a6a6a6",
      "focusedBorderColor": "#f5c400",
      "default.startBackground": "#f5c400",
      "default.endBackground": "#f5c400",
      "default.foreground": "#000000",
      "default.startBorderColor": "#f5c400",
      "default.endBorderColor": "#f5c400",
      "default.focusColor": "#ffffff",
      "default.focusedBorderColor": "#ffffff"
    },
    "TextField": {
      "background": "#000000",
      "foreground": "#ffffff"
    },
    "TextArea": {
      "background": "#000000",
      "foreground": "#ffffff"
