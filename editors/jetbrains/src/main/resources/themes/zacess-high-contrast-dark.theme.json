{
  "name": "Zacess High Contrast Dark",
  "dark": true,
  "author": "Zacess",
  "editorScheme": "/themes/zacess-high-contrast-dark.icls",
  "ui": {
    "*": {
      "background": "#000000",
      "foreground": "#ffffff",
      "infoForeground": "#e0e0e0",
      "disabledForeground": "#e0e0e0",
      "inactiveForeground": "#e0e0e0",
      "selectionBackground": "#0a2552",
      "selectionForeground": "#ffffff",
      "selectionInactiveBackground": "#1a1a1a",
      "selectionBackgroundInactive": "#1a1a1a",
      "selectionInactiveForeground": "#ffffff",
      "hoverBackground": "#1a1a1a",
      "borderColor": "#a6a6a6",
      "separatorColor": "#a6a6a6",
      "focusColor": "#f5c400",
      "focusedBorderColor": "#f5c400",
      "errorForeground": "#ff9e94",
      "acceleratorForeground": "#e0e0e0"
    },
    "Component": {
      "focusWidth": 2,
      "focusColor": "#f5c400",
      "focusedBorderColor": "#f5c400",
