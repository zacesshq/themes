{
  "name": "Zacess Deep Contrast Dark",
  "dark": true,
  "author": "Zacess",
  "editorScheme": "/themes/zacess-deep-contrast-dark.xml",
  "ui": {
    "*": {
      "background": "#000000",
      "foreground": "#ffffff",
      "infoForeground": "#b3b3b3",
      "disabledForeground": "#b3b3b3",
      "inactiveForeground": "#b3b3b3",
      "selectionBackground": "#1c1c38",
      "selectionForeground": "#ffffff",
      "selectionInactiveBackground": "#141414",
      "selectionBackgroundInactive": "#141414",
      "selectionInactiveForeground": "#ffffff",
      "hoverBackground": "#141414",
      "borderColor": "#00ffff",
      "separatorColor": "#00ffff",
      "focusColor": "#ffff00",
      "focusedBorderColor": "#ffff00",
      "errorForeground": "#fe8167",
      "acceleratorForeground": "#b3b3b3"
