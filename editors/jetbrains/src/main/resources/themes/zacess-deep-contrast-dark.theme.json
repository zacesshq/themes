      "endBorderColor": "#00ffff",
      "focusedBorderColor": "#ffff00",
      "default.startBackground": "#00ffff",
      "default.endBackground": "#00ffff",
      "default.foreground": "#000000",
      "default.startBorderColor": "#00ffff",
      "default.endBorderColor": "#00ffff",
      "default.focusColor": "#ffffff",
      "default.focusedBorderColor": "#ffffff"
    },
    "TextField": {
      "background": "#000000",
      "foreground": "#ffffff"
    },
    "TextArea": {
      "background": "#000000",
      "foreground": "#ffffff"
    },
    "ComboBox": {
      "background": "#000000",
      "foreground": "#ffffff",
      "nonEditableBackground": "#000000"
    },
    "EditorPane": {
      "background": "#000000"
