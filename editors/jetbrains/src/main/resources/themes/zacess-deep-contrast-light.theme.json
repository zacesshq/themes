    "List": {
      "background": "#ffffff",
      "foreground": "#000000",
      "selectionBackground": "#f0f5ff",
      "selectionForeground": "#000000",
      "selectionInactiveBackground": "#f5f5f5"
    },
    "Table": {
      "background": "#ffffff",
      "foreground": "#000000",
      "selectionBackground": "#f0f5ff",
      "selectionForeground": "#000000"
    },
    "Popup": {
      "background": "#ffffff",
      "borderColor": "#0f4a85"
    },
    "ToolTip": {
      "background": "#ffffff",
      "foreground": "#000000",
      "borderColor": "#0f4a85"
    },
    "Notification": {
      "background": "#ffffff",
      "foreground": "#000000",
      "borderColor": "#0f4a85"
