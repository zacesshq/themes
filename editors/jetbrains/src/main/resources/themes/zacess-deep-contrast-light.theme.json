    "SearchMatch": {
      "startBackground": "#fff1a0",
      "endBackground": "#fff1a0"
    },
    "Counter": {
      "background": "#0f4a85",
      "foreground": "#ffffff"
    },
    "ScrollBar": {
      "Mac.thumbColor": "#6e6e6e",
      "Mac.hoverThumbColor": "#0f4a85",
      "thumbColor": "#6e6e6e",
      "hoverThumbColor": "#0f4a85"
    }
