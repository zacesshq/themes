      "HeaderTab.selectedInactiveBackground": "#f5f5f5",
      "Button.selectedBackground": "#f0f5ff",
      "Button.selectedForeground": "#000000"
    },
    "MainToolbar": {
      "background": "#ffffff",
      "inactiveBackground": "#ffffff"
