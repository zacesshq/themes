{
  "name": "Zacess Deep Contrast Light",
  "dark": false,
  "author": "Zacess",
  "editorScheme": "/themes/zacess-deep-contrast-light.icls",
  "ui": {
    "*": {
      "background": "#ffffff",
      "foreground": "#000000",
      "infoForeground": "#4d4d4d",
      "disabledForeground": "#4d4d4d",
      "inactiveForeground": "#4d4d4d",
      "selectionBackground": "#f0f5ff",
      "selectionForeground": "#000000",
      "selectionInactiveBackground": "#f5f5f5",
      "selectionBackgroundInactive": "#f5f5f5",
      "selectionInactiveForeground": "#000000",
      "hoverBackground": "#f5f5f5",
      "borderColor": "#0f4a85",
      "separatorColor": "#0f4a85",
      "focusColor": "#b5200d",
      "focusedBorderColor": "#b5200d",
      "errorForeground": "#aa0000",
      "acceleratorForeground": "#4d4d4d"
    },
    "Component": {
      "focusWidth": 2,
      "focusColor": "#b5200d",
      "focusedBorderColor": "#b5200d",
      "borderColor": "#0f4a85",
