      "endBackground": "#ffffff",
      "foreground": "#000000",
      "startBorderColor": "#0f4a85",
      "endBorderColor": "#0f4a85",
      "focusedBorderColor": "#b5200d",
      "default.startBackground": "#0f4a85",
      "default.endBackground": "#0f4a85",
      "default.foreground": "#ffffff",
      "default.startBorderColor": "#0f4a85",
      "default.endBorderColor": "#0f4a85",
      "default.focusColor": "#000000",
      "default.focusedBorderColor": "#000000"
    },
    "TextField": {
      "background": "#ffffff",
      "foreground": "#000000"
    },
    "TextArea": {
      "background": "#ffffff",
      "foreground": "#000000"
    },
    "ComboBox": {
      "background": "#ffffff",
      "foreground": "#000000",
      "nonEditableBackground": "#ffffff"
    },
    "EditorPane": {
      "background": "#ffffff"
    },
    "EditorTabs": {
      "background": "#ffffff",
      "underlinedTabBackground": "#ffffff",
      "underlinedTabForeground": "#000000",
      "underlineColor": "#b5200d",
      "underlineHeight": 3,
      "inactiveUnderlineColor": "#0f4a85"
    },
    "ToolWindow": {
      "Header.background": "#ffffff",
